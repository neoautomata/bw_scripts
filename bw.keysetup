#!/usr/bin/env bash

set -euo pipefail

UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
ATTACHMENT_ID_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'
HOST_RE='^[A-Za-z0-9._:-]+$'
SALT_RE='^([./0-9A-Za-z]{4}){8,16}$'
PUBKEY_RE='^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) [A-Za-z0-9+/=]+([[:space:]]+[^[:cntrl:]]*)?$'

is_valid_uuid() {
  [[ "${1}" =~ ${UUID_RE} ]]
}

is_valid_attachment_id() {
  [[ "${1}" =~ ${ATTACHMENT_ID_RE} ]]
}

is_valid_host() {
  [[ "${1}" =~ ${HOST_RE} && "${1}" != -* ]]
}

strip_trailing_slashes() {
  local path="${1}"
  while [[ "${path}" != "/" && "${path}" == */ ]]; do
    path="${path%/}"
  done
  printf '%s\n' "${path}"
}

is_valid_runtime_dir() {
  local dir
  dir="$(strip_trailing_slashes "${1}")"
  local require_owner="${2}"
  local ancestor=""
  local dir_uid=""
  local fs_type=""

  if [[ "${dir}" != /* ]]; then
    return 1
  fi
  if [[ "${dir}/" == *"/../"* || "${dir}/" == *"/./"* ]]; then
    return 1
  fi

  # Reject symlinks on the target directory and every ancestor component.
  ancestor="${dir}"
  while [[ "${ancestor}" != "/" && -n "${ancestor}" ]]; do
    if [[ -L "${ancestor}" ]]; then
      return 1
    fi
    ancestor="${ancestor%/*}"
    if [[ -z "${ancestor}" ]]; then
      ancestor="/"
    fi
  done
  if [[ -L "/" ]]; then
    return 1
  fi

  if [[ ! -d "${dir}" || ! -w "${dir}" ]]; then
    return 1
  fi

  if [[ "${require_owner}" -eq 1 ]]; then
    if [[ ! -O "${dir}" ]]; then
      return 1
    fi
  else
    dir_uid="$(stat -c '%u' "${dir}" 2>/dev/null || true)"
    if [[ ! -k "${dir}" || "${dir_uid}" != "0" ]]; then
      return 1
    fi
  fi

  fs_type="$(stat -f -c '%T' "${dir}" 2>/dev/null || true)"
  if [[ "${fs_type}" != "tmpfs" && "${fs_type}" != "ramfs" ]]; then
    return 1
  fi
  return 0
}

validate_ssh_args() {
  local seen_dest=0
  local end_of_opts=0
  local arg rest char i len

  while [[ $# -gt 0 ]]; do
    arg="${1}"
    shift

    if [[ "${end_of_opts}" -eq 0 && "${arg}" == "--" ]]; then
      end_of_opts=1
      continue
    fi

    if [[ "${end_of_opts}" -eq 0 && "${seen_dest}" -eq 0 && "${arg}" == -* && "${arg}" != "-" ]]; then
      rest="${arg:1}"
      len="${#rest}"
      i=0
      while [[ "${i}" -lt "${len}" ]]; do
        char="${rest:${i}:1}"
        case "${char}" in
          N|f|t|W|G|V|Q)
            echo "Error: bw.keysetup does not support option -${char}." >&2
            return 1
            ;;
          B|b|c|D|E|e|F|I|i|J|L|l|m|O|o|P|p|R|S|w)
            if [[ $((i + 1)) -lt "${len}" ]]; then
              break
            fi
            if [[ $# -eq 0 ]]; then
              echo "Error: Option -${char} requires a value." >&2
              return 1
            fi
            shift
            break
            ;;
          *)
            i=$((i + 1))
            ;;
        esac
      done
    else
      if [[ "${seen_dest}" -eq 1 ]]; then
        echo "Error: Unexpected argument after destination: ${arg}." >&2
        return 1
      fi
      seen_dest=1
    fi
  done

  if [[ "${seen_dest}" -eq 0 ]]; then
    echo "Error: Specify a destination argument." >&2
    return 1
  fi
  return 0
}

if [[ $# -eq 0 ]]; then
  echo "Usage: bw.keysetup [ssh-options] root@<host>" >&2
  exit 1
fi

if ! validate_ssh_args "$@"; then
  exit 1
fi

if ! bw.sess; then
  echo "Error: bw.sess failed." >&2
  exit 1
fi

if ! cfg="$(ssh -G "$@")"; then
  echo "Error: ssh -G failed." >&2
  exit 1
fi

user="$(printf '%s\n' "${cfg}" | awk 'tolower($1) == "user" {print $2; exit}')"
host="$(printf '%s\n' "${cfg}" | awk 'tolower($1) == "hostname" {print $2; exit}')"
full_ssh=("$@")
unset cfg

if [[ -z "${user}" || -z "${host}" ]]; then
  echo "Error: ssh -G did not return user or hostname." >&2
  exit 1
fi

if [[ "${user}" != "root" ]]; then
  echo "Error: Target user must be root, got ${user}." >&2
  exit 1
fi

if ! is_valid_host "${host}"; then
  echo "Error: Hostname '${host}' contains invalid characters." >&2
  exit 1
fi

TMP_DIRS=()
CREATED_TMP_DIR=""

cleanup_tmp_dirs() {
  local dir
  if [[ "${#TMP_DIRS[@]}" -gt 0 ]]; then
    for dir in "${TMP_DIRS[@]}"; do
      if [[ -n "${dir}" && -d "${dir}" ]]; then
        rm -rf -- "${dir}"
      fi
    done
  fi
  TMP_DIRS=()
}

trap cleanup_tmp_dirs EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

make_tmp_dir() {
  local runtime_dir old_umask dir
  runtime_dir="$(strip_trailing_slashes "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}")"
  if ! is_valid_runtime_dir "${runtime_dir}" 1; then
    if is_valid_runtime_dir "/dev/shm" 0; then
      runtime_dir="/dev/shm"
    else
      echo "Error: No writable RAM-backed runtime directory exists." >&2
      return 1
    fi
  fi

  old_umask="$(umask)"
  umask 077
  dir="$(mktemp -d "${runtime_dir}/bw_keysetup.XXXXXXXXXX")"
  umask "${old_umask}"

  TMP_DIRS+=("${dir}")
  CREATED_TMP_DIR="${dir}"
}

remove_tmp_dir() {
  local target="${1}"
  local new_dirs=()
  local dir

  if [[ -n "${target}" && -d "${target}" ]]; then
    rm -rf -- "${target}"
  fi

  if [[ "${#TMP_DIRS[@]}" -gt 0 ]]; then
    for dir in "${TMP_DIRS[@]}"; do
      if [[ "${dir}" != "${target}" ]]; then
        new_dirs+=("${dir}")
      fi
    done
  fi

  if [[ "${#new_dirs[@]}" -gt 0 ]]; then
    TMP_DIRS=("${new_dirs[@]}")
  else
    TMP_DIRS=()
  fi
}

sh_quote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

preflightRemote() {
  local preflight_script
  IFS= read -r -d '' preflight_script <<'EOF' || true
set -euo pipefail
remote_uid="$(id -u)"
if [[ "${remote_uid}" != "0" ]]; then
  echo "Error: Remote shell UID must be 0, got ${remote_uid}." >&2
  exit 1
fi

if command -v perl >/dev/null 2>&1; then
  probe="$(perl -e 'my $h = crypt("probe", "\$y\$j9T\$aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\$"); defined($h) && print $h' 2>/dev/null || true)"
  if [[ "${probe}" != \$y\$j9T\$* ]]; then
    echo "Error: Remote host does not support Yescrypt hashes." >&2
    exit 1
  fi
elif command -v python3 >/dev/null 2>&1 && python3 -c 'import crypt' >/dev/null 2>&1; then
  probe="$(python3 -c 'import crypt; h = crypt.crypt("probe", "$y$j9T$aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa$"); print(h or "")' 2>/dev/null || true)"
  if [[ "${probe}" != \$y\$j9T\$* ]]; then
    echo "Error: Remote host does not support Yescrypt hashes." >&2
    exit 1
  fi
else
  yescrypt_ok=0
  if [[ -r /etc/shadow ]] && grep -q ':\$y\$' /etc/shadow; then
    yescrypt_ok=1
  elif [[ -r /etc/login.defs ]] && grep -Eiq '^[[:space:]]*ENCRYPT_METHOD[[:space:]]+YESCRYPT([[:space:]]|#|$)' /etc/login.defs; then
    yescrypt_ok=1
  fi
  if [[ "${yescrypt_ok}" -ne 1 ]]; then
    echo "Error: Remote host cannot check Yescrypt support." >&2
    exit 1
  fi
fi
EOF
  if ! ssh -n -o RequestTTY=no "${full_ssh[@]}" bash -c "$(sh_quote "${preflight_script}")"; then
    echo "Error: Remote pre-flight check failed for ${host}." >&2
    return 1
  fi
}

findOrCreateItem() {
  local target_user="${1}"
  local target_host="${2}"
  local query="${target_user}@${target_host}"
  local search_rc=0
  local itemID=""

  itemID="$(bw.item.search "${query}")" || search_rc=$?

  case "${search_rc}" in
    0)
      if ! is_valid_uuid "${itemID}"; then
        echo "Error: Item search returned an invalid UUID for ${query}." >&2
        return 1
      fi
      echo "Found item for ${query}." >&2
      printf '%s\n' "${itemID}"
      return 0
      ;;
    2)
      echo "Creating item for ${query}." >&2

      local pw salt
      if ! pw="$(bw generate -lun --length 32)"; then
        echo "Error: bw generate failed for password." >&2
        return 1
      fi
      if [[ "${#pw}" -lt 32 || "${pw}" == *$'\n'* || "${pw}" == *$'\r'* ]]; then
        unset pw
        echo "Error: Generated password is invalid." >&2
        return 1
      fi

      if ! salt="$(bw generate -lun --length 32)"; then
        unset pw
        echo "Error: bw generate failed for salt." >&2
        return 1
      fi
      if [[ ! "${salt}" =~ ${SALT_RE} ]]; then
        unset pw salt
        echo "Error: Generated salt is invalid." >&2
        return 1
      fi

      local template_item template_login created_json
      template_item="$(bw get template item)"
      template_login="$(bw get template item.login)"

      # Pass secrets through stdin pipes so process argv never contains them.
      created_json="$(
        {
          printf '%s\n' "${template_item}"
          printf '%s\n' "${template_login}"
          printf '%s' "${pw}" | jq -Rs .
          printf '%s' "${salt}" | jq -Rs .
        } | jq -s --arg name "${query}" --arg username "${target_user}" '
          .[0] as $item
          | .[1] as $login
          | .[2] as $pw
          | .[3] as $salt
          | $item
          | .notes = ""
          | .name = $name
          | .login = ($login | .username = $username | .totp = "" | .password = $pw)
          | .fields = [{name: "password_salt", value: $salt, type: 0}]
        ' | bw encode | bw create item
      )"
      unset pw salt template_item template_login

      if ! itemID="$(printf '%s\n' "${created_json}" | jq -er '.id | strings | select(length > 0)')"; then
        unset created_json
        echo "Error: Cannot extract ID from created item for ${query}." >&2
        return 1
      fi
      unset created_json

      if ! is_valid_uuid "${itemID}"; then
        echo "Error: Created item returned an invalid UUID for ${query}." >&2
        return 1
      fi

      bw sync >/dev/null 2>&1 || echo "Warning: Bitwarden sync failed." >&2
      printf '%s\n' "${itemID}"
      return 0
      ;;
    *)
      echo "Error: Item search failed for ${query}." >&2
      return "${search_rc}"
      ;;
  esac
}

checkPassLen() {
  local itemID="${1}"
  local pass_rc=0
  local current_pw=""
  local needs_regen=0

  current_pw="$(bw.item.pass "${itemID}")" || pass_rc=$?
  case "${pass_rc}" in
    0) ;;
    2) current_pw="" ;;
    *)
      echo "Error: Cannot read password for item ${itemID}." >&2
      return "${pass_rc}"
      ;;
  esac

  if [[ "${#current_pw}" -lt 32 || "${current_pw}" == *$'\n'* || "${current_pw}" == *$'\r'* ]]; then
    needs_regen=1
  fi
  unset current_pw

  if [[ "${needs_regen}" -eq 1 ]]; then
    local new_pw item_json
    item_json="$(bw.item.get "${itemID}")"
    if ! printf '%s\n' "${item_json}" | jq -e '.type == 1 and (.login | type == "object")' >/dev/null; then
      unset item_json
      echo "Error: Vault item ${itemID} is not a login item." >&2
      return 1
    fi

    echo "Updating password to 32 characters."
    if ! new_pw="$(bw generate -lun --length 32)"; then
      unset item_json
      echo "Error: bw generate failed for password." >&2
      return 1
    fi
    if [[ "${#new_pw}" -lt 32 || "${new_pw}" == *$'\n'* || "${new_pw}" == *$'\r'* ]]; then
      unset new_pw item_json
      echo "Error: Generated password is invalid." >&2
      return 1
    fi

    {
      printf '%s\n' "${item_json}"
      printf '%s' "${new_pw}" | jq -Rs .
    } | jq -s '.[1] as $pw | .[0] | .login.password = $pw' | bw encode | bw edit item "${itemID}" >/dev/null
    unset new_pw item_json

    bw sync >/dev/null 2>&1 || echo "Warning: Bitwarden sync failed." >&2
  fi
}

checkSaltLen() {
  local itemID="${1}"
  local salt_rc=0
  local current_salt=""
  local needs_regen=0

  current_salt="$(bw.item.field "${itemID}" "password_salt")" || salt_rc=$?
  case "${salt_rc}" in
    0) ;;
    2) current_salt="" ;;
    *)
      echo "Error: Cannot read password_salt for item ${itemID}." >&2
      return "${salt_rc}"
      ;;
  esac

  if [[ ! "${current_salt}" =~ ${SALT_RE} ]]; then
    needs_regen=1
  fi
  unset current_salt

  if [[ "${needs_regen}" -eq 1 ]]; then
    echo "Updating password salt to 32 characters."
    local new_salt item_json
    if ! new_salt="$(bw generate -lun --length 32)"; then
      echo "Error: bw generate failed for salt." >&2
      return 1
    fi
    if [[ ! "${new_salt}" =~ ${SALT_RE} ]]; then
      unset new_salt
      echo "Error: Generated salt is invalid." >&2
      return 1
    fi

    item_json="$(bw.item.get "${itemID}")"
    {
      printf '%s\n' "${item_json}"
      printf '%s' "${new_salt}" | jq -Rs .
    } | jq -s '
      .[1] as $salt
      | .[0]
      | .fields = (
          ((.fields // []) | map(select(.name != "password_salt")))
          + [{name: "password_salt", value: $salt, type: 0}]
        )
    ' | bw encode | bw edit item "${itemID}" >/dev/null
    unset new_salt item_json

    bw sync >/dev/null 2>&1 || echo "Warning: Bitwarden sync failed." >&2
  fi
}

checkPass() {
  local itemID="${1}"
  local target_user="${2}"
  local prefix want have pw salt remote_user_q remote_script

  pw="$(bw.item.pass "${itemID}")"
  salt="$(bw.item.field "${itemID}" "password_salt")"

  if [[ -z "${pw}" || "${pw}" == *$'\n'* || "${pw}" == *$'\r'* ]]; then
    unset pw salt
    echo "Error: Password for ${target_user} is empty or contains a line break." >&2
    return 1
  fi

  if [[ ! "${salt}" =~ ${SALT_RE} ]]; then
    unset pw salt
    echo "Error: Password salt for ${target_user} is invalid." >&2
    return 1
  fi

  prefix="\$y\$j9T\$${salt}\$"
  # Pass password and salt through stdin with NUL delimiters so argv never contains them.
  want="$(
    printf '%s\0%s\0' "${pw}" "${prefix}" | perl -e '
      local $/ = "\0";
      my $pass = <STDIN>;
      my $pref = <STDIN>;
      defined($pass) && defined($pref) or exit 1;
      chomp($pass);
      chomp($pref);
      my $hash = crypt($pass, $pref);
      defined($hash) or exit 1;
      print $hash;
    '
  )"
  unset pw salt

  if [[ "${want}" != \$y\$* || "${want}" != "${prefix}"* ]]; then
    echo "Error: Generated Yescrypt hash is invalid for ${target_user}." >&2
    return 1
  fi

  remote_user_q="$(sh_quote "${target_user}")"
  # shellcheck disable=SC2029
  have="$(ssh -n -o RequestTTY=no "${full_ssh[@]}" getent shadow "${remote_user_q}" | cut -d: -f2)"

  if [[ "${want}" != "${have}" ]]; then
    echo "Updating password for ${target_user}."

    IFS= read -r -d '' remote_script <<'EOF' || true
set -euo pipefail
target_user="${1}"
IFS= read -r entry
expected_hash="${entry#*:}"
backup=""
backup_ready=0
updated=0

cleanup_shadow() {
  if [[ "${backup_ready}" -eq 1 && "${updated}" -ne 1 && -n "${backup}" && -f "${backup}" ]]; then
    if ! mv -f -- "${backup}" /etc/shadow; then
      echo "CRITICAL: Failed to restore /etc/shadow from ${backup}." >&2
    fi
  elif [[ -n "${backup}" && -f "${backup}" ]]; then
    rm -f -- "${backup}" || true
  fi
  backup=""
  backup_ready=0
}
trap cleanup_shadow EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

old_umask="$(umask)"
umask 077
backup="$(mktemp /etc/shadow.bw_keysetup.XXXXXXXXXX)"
umask "${old_umask}"
if ! cp -a /etc/shadow "${backup}" || [[ ! -s "${backup}" ]]; then
  echo "Error: Cannot copy /etc/shadow to backup file." >&2
  exit 1
fi
backup_ready=1
printf "%s\n" "${entry}" | chpasswd -e
actual_hash="$(getent shadow "${target_user}" | cut -d: -f2)"
if [[ "${actual_hash}" != "${expected_hash}" ]]; then
  echo "Error: Remote shadow hash does not match expected hash." >&2
  exit 1
fi
updated=1
rm -f -- "${backup}"
backup=""
backup_ready=0
EOF
    printf '%s:%s\n' "${target_user}" "${want}" | ssh -o RequestTTY=no "${full_ssh[@]}" bash -c "$(sh_quote "${remote_script}")" _ "${remote_user_q}"
  else
    echo "Password matches for ${target_user}."
  fi
}

configSSHKey() {
  local itemID="${1}"
  local target_user="${2}"
  local target_host="${3}"
  local query="${target_user}@${target_host}"
  local key_rc=0
  local keyID=""

  keyID="$(bw.item.privKeyID "${itemID}" "${query}")" || key_rc=$?

  case "${key_rc}" in
    0)
      if ! is_valid_attachment_id "${keyID}"; then
        echo "Error: Private key search returned an invalid attachment ID for ${query}." >&2
        return 1
      fi
      echo "SSH key already exists for ${query}."
      ;;
    2)
      local existing_pub_rc=0
      bw.item.pubKeyID "${itemID}" "${query}" >/dev/null || existing_pub_rc=$?
      if [[ "${existing_pub_rc}" -ne 2 ]]; then
        if [[ "${existing_pub_rc}" -eq 0 || "${existing_pub_rc}" -eq 3 ]]; then
          echo "Error: Orphan public key attachment exists for ${query}." >&2
        else
          echo "Error: Public key search failed for ${query}." >&2
        fi
        return 1
      fi

      echo "Creating SSH key for ${query}."
      make_tmp_dir
      local tmp_dir="${CREATED_TMP_DIR}"
      local keypath="${tmp_dir}/${query}"
      local upload_json=""
      local uploaded_priv_id=""

      ssh-keygen -t ed25519 -f "${keypath}" -N "" -C "${query}" >/dev/null
      # Upload the private key before the public key and revert on partial failure.
      if ! upload_json="$(bw create attachment --itemid "${itemID}" --file "${keypath}")"; then
        remove_tmp_dir "${tmp_dir}"
        echo "Error: Cannot upload private key attachment for ${query}." >&2
        return 1
      fi
      uploaded_priv_id="$(printf '%s\n' "${upload_json}" | jq -r --arg fn "${query}" '(.attachments // []) | map(select(.fileName == $fn)) | last | .id // empty' 2>/dev/null || true)"
      unset upload_json
      if [[ -z "${uploaded_priv_id}" ]]; then
        uploaded_priv_id="$(bw.item.privKeyID "${itemID}" "${query}" 2>/dev/null || true)"
      fi

      if ! bw create attachment --itemid "${itemID}" --file "${keypath}.pub" >/dev/null; then
        if is_valid_attachment_id "${uploaded_priv_id}"; then
          if ! bw delete attachment "${uploaded_priv_id}" --itemid "${itemID}" >/dev/null 2>&1; then
            echo "Warning: Cannot delete partial private key attachment ${uploaded_priv_id} for ${query}." >&2
          fi
        fi
        remove_tmp_dir "${tmp_dir}"
        echo "Error: Cannot upload public key attachment for ${query}." >&2
        return 1
      fi
      remove_tmp_dir "${tmp_dir}"

      bw sync >/dev/null 2>&1 || echo "Warning: Bitwarden sync failed." >&2
      ;;
    *)
      echo "Error: Private key search failed for ${query}." >&2
      return "${key_rc}"
      ;;
  esac

  local pub_rc=0
  local pubKeyID=""
  pubKeyID="$(bw.item.pubKeyID "${itemID}" "${query}")" || pub_rc=$?
  if [[ "${pub_rc}" -ne 0 ]] || ! is_valid_attachment_id "${pubKeyID}"; then
    echo "Error: Cannot find valid public key attachment ID for ${query}." >&2
    return 1
  fi

  local pub_key
  pub_key="$(bw get attachment "${pubKeyID}" --itemid "${itemID}" --raw)"
  if [[ -z "${pub_key}" ]]; then
    echo "Error: Public key attachment is empty for ${query}." >&2
    return 1
  fi
  if [[ "${pub_key}" == *$'\n'* || "${pub_key}" == *$'\r'* ]]; then
    echo "Error: Public key contains a line break for ${query}." >&2
    return 1
  fi
  if [[ ! "${pub_key}" =~ ${PUBKEY_RE} ]]; then
    echo "Error: Public key format is invalid for ${query}." >&2
    return 1
  fi
  if ! printf '%s\n' "${pub_key}" | ssh-keygen -l -f /dev/stdin >/dev/null 2>&1; then
    echo "Error: Public key failed ssh-keygen check for ${query}." >&2
    return 1
  fi

  local remote_user_q install_key_script
  remote_user_q="$(sh_quote "${target_user}")"
  IFS= read -r -d '' install_key_script <<'EOF' || true
set -euo pipefail
target_user="${1}"
IFS= read -r pub_key
if [[ -z "${pub_key}" ]]; then
  echo "Error: Public key input is empty." >&2
  exit 1
fi
passwd_entry="$(getent passwd "${target_user}")"
home_dir="$(printf "%s\n" "${passwd_entry}" | cut -d: -f6)"
if [[ -z "${home_dir}" || -L "${home_dir}" || ! -d "${home_dir}" ]]; then
  echo "Error: Home directory is invalid for ${target_user}." >&2
  exit 1
fi

user_install_script='
set -eu
IFS= read -r home_dir
IFS= read -r pub_key
ssh_dir="${home_dir}/.ssh"
auth_keys="${ssh_dir}/authorized_keys"
if [ -L "${ssh_dir}" ]; then
  echo "Error: SSH directory is a symlink." >&2
  exit 1
fi
if [ -e "${ssh_dir}" ] && [ ! -d "${ssh_dir}" ]; then
  echo "Error: SSH path is not a directory." >&2
  exit 1
fi
umask 077
mkdir -p -- "${ssh_dir}"
chmod 700 -- "${ssh_dir}"
if [ -L "${auth_keys}" ]; then
  echo "Error: authorized_keys is a symlink." >&2
  exit 1
fi
if [ -e "${auth_keys}" ] && [ ! -f "${auth_keys}" ]; then
  echo "Error: authorized_keys is not a regular file." >&2
  exit 1
fi
tmp_keys=""
cleanup_keys() {
  if [ -n "${tmp_keys}" ] && [ -e "${tmp_keys}" ]; then
    rm -f -- "${tmp_keys}"
  fi
}
trap cleanup_keys EXIT
trap '\''exit 129'\'' HUP
trap '\''exit 130'\'' INT
trap '\''exit 143'\'' TERM
tmp_keys="$(mktemp "${ssh_dir}/.authorized_keys.tmp.XXXXXXXXXX")"
chmod 600 -- "${tmp_keys}"
if [ -s "${auth_keys}" ]; then
  awk '\''1'\'' "${auth_keys}" > "${tmp_keys}"
fi
if ! grep -qxF -- "${pub_key}" "${tmp_keys}"; then
  printf "%s\n" "${pub_key}" >> "${tmp_keys}"
fi
mv -f -- "${tmp_keys}" "${auth_keys}"
tmp_keys=""
'

if [[ "${target_user}" == "root" ]]; then
  {
    printf '%s\n' "${home_dir}"
    printf '%s\n' "${pub_key}"
  } | sh -eu -c "${user_install_script}"
else
  target_uid="$(id -u "${target_user}")"
  if [[ "${target_uid}" == "0" ]]; then
    echo "Error: Non-root user ${target_user} has UID 0." >&2
    exit 1
  fi
  home_uid="$(stat -c '%u' "${home_dir}")"
  if [[ "${home_uid}" != "${target_uid}" ]]; then
    echo "Error: ${target_user} does not own home directory ${home_dir}." >&2
    exit 1
  fi
  # Drop privileges to target_user so symlinks cannot write to root files.
  {
    printf '%s\n' "${home_dir}"
    printf '%s\n' "${pub_key}"
  } | if command -v runuser >/dev/null 2>&1; then
    runuser -u "${target_user}" -- sh -eu -c "${user_install_script}"
  else
    su -s /bin/sh -c "${user_install_script}" -- "${target_user}"
  fi
fi

if command -v restorecon >/dev/null 2>&1 && [[ ! -L "${home_dir}/.ssh" && -d "${home_dir}/.ssh" ]]; then
  restorecon -R -- "${home_dir}/.ssh" 2>/dev/null || true
fi
EOF
  printf '%s\n' "${pub_key}" | ssh -o RequestTTY=no "${full_ssh[@]}" bash -c "$(sh_quote "${install_key_script}")" _ "${remote_user_q}"
}

ensureJumperUser() {
  local jumper_script
  IFS= read -r -d '' jumper_script <<'EOF' || true
set -euo pipefail
if ! id -u jumper >/dev/null 2>&1; then
  login_shell="/bin/bash"
  if [[ ! -x "${login_shell}" ]]; then
    login_shell="/bin/sh"
  fi
  useradd -m -s "${login_shell}" -c 'jumper user' jumper
fi
jumper_shell="$(getent passwd jumper | cut -d: -f7)"
case "${jumper_shell}" in
  ""|/sbin/nologin|/usr/sbin/nologin|/usr/bin/nologin|/bin/false|/usr/bin/false)
    echo "Error: User jumper has a non-interactive shell: ${jumper_shell}." >&2
    exit 1
    ;;
esac
EOF
  ssh -n -o RequestTTY=no "${full_ssh[@]}" bash -c "$(sh_quote "${jumper_script}")"
}

updateSSHDConfig() {
  local remote_args=("$@")

  echo "Configuring PermitRootLogin prohibit-password."

  ssh -o RequestTTY=no "${remote_args[@]}" /usr/bin/env bash << 'EOF'
set -euo pipefail

SSH_DIR="/etc/ssh"
CONFIG="${SSH_DIR}/sshd_config"
DROPIN_DIR="${SSH_DIR}/sshd_config.d"
DROPIN_FILE="${DROPIN_DIR}/00-bw-keysetup.conf"
BACKUP=""
BACKUP_READY=0
TARGET=""
TMP_CFG=""
EXISTED=0
WRITTEN=0
RELOAD_ATTEMPTED=0
SSH_UNIT=""
COMMITTED=0

revert_sshd() {
  if [[ -n "${TMP_CFG}" && -f "${TMP_CFG}" ]]; then
    rm -f -- "${TMP_CFG}" || true
    TMP_CFG=""
  fi
  if [[ "${COMMITTED}" -eq 1 ]]; then
    return 0
  fi
  if [[ "${WRITTEN}" -eq 1 ]]; then
    if [[ "${EXISTED}" -eq 1 ]]; then
      if [[ "${BACKUP_READY}" -eq 1 && -n "${BACKUP}" && -f "${BACKUP}" ]]; then
        if ! mv -f -- "${BACKUP}" "${TARGET}"; then
          echo "CRITICAL: Failed to restore ${TARGET} from ${BACKUP}." >&2
          return 0
        fi
        BACKUP=""
        BACKUP_READY=0
      fi
    elif [[ "${EXISTED}" -eq 0 && -n "${TARGET}" && -f "${TARGET}" ]]; then
      if ! rm -f -- "${TARGET}"; then
        echo "CRITICAL: Failed to delete ${TARGET} during rollback." >&2
        return 0
      fi
    fi
    if [[ "${RELOAD_ATTEMPTED}" -eq 1 && -n "${SSH_UNIT}" ]]; then
      systemctl reload-or-restart "${SSH_UNIT}" >/dev/null 2>&1 || \
        echo "CRITICAL: Failed to reload ${SSH_UNIT} after rollback." >&2
    fi
  fi
  if [[ -n "${BACKUP}" && -f "${BACKUP}" ]]; then
    rm -f -- "${BACKUP}" || true
    BACKUP=""
    BACKUP_READY=0
  fi
}
trap revert_sshd EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

if [[ -L "${CONFIG}" || ! -f "${CONFIG}" ]]; then
  echo "Error: ${CONFIG} is missing or is a symlink." >&2
  exit 1
fi

use_dropin=0
if [[ -d "${DROPIN_DIR}" && ! -L "${DROPIN_DIR}" ]]; then
  if awk '
    BEGIN { found = 0 }
    /^[[:space:]]*(#|$)/ { next }
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      low = tolower(line)
      if (low ~ /^match([[:space:]=]|$)/) {
        exit 1
      }
      if (low ~ /^permitrootlogin([[:space:]=]|$)/) {
        exit 1
      }
      if (low ~ /^include([[:space:]]+|=)/) {
        rest = line
        sub(/^[Ii][Nn][Cc][Ll][Uu][Dd][Ee]([[:space:]]+|=)[[:space:]]*/, "", rest)
        n = split(rest, toks, /[[:space:]]+/)
        for (i = 1; i <= n; i++) {
          tok = toks[i]
          if (tok ~ /^#/) break
          gsub(/^"|"$/, "", tok)
          if (tok == "/etc/ssh/sshd_config.d/*.conf" || tok == "sshd_config.d/*.conf") {
            found = 1
            exit 0
          }
        }
      }
    }
    END { exit (found ? 0 : 1) }
  ' "${CONFIG}"; then
    use_dropin=1
  fi
fi

if [[ "${use_dropin}" -eq 1 ]]; then
  if [[ -L "${DROPIN_FILE}" ]]; then
    echo "Error: ${DROPIN_FILE} is a symlink." >&2
    exit 1
  fi
  TARGET="${DROPIN_FILE}"
  if [[ -f "${TARGET}" ]]; then
    EXISTED=1
    old_umask="$(umask)"
    umask 077
    BACKUP="$(mktemp "${SSH_DIR}/sshd_dropin.bw_keysetup.bak.XXXXXXXXXX")"
    umask "${old_umask}"
    if ! cp -a "${TARGET}" "${BACKUP}" || [[ ! -s "${BACKUP}" ]]; then
      echo "Error: Cannot copy ${TARGET} to backup file." >&2
      exit 1
    fi
    BACKUP_READY=1
  fi
  old_umask="$(umask)"
  umask 077
  TMP_CFG="$(mktemp "${SSH_DIR}/sshd_dropin.bw_keysetup.tmp.XXXXXXXXXX")"
  umask "${old_umask}"
  printf 'PermitRootLogin prohibit-password\n' > "${TMP_CFG}"
  chmod 600 "${TMP_CFG}"
  mv -f -- "${TMP_CFG}" "${TARGET}"
  TMP_CFG=""
  WRITTEN=1
else
  TARGET="${CONFIG}"
  EXISTED=1
  old_umask="$(umask)"
  umask 077
  BACKUP="$(mktemp "${SSH_DIR}/sshd_config.bw_keysetup.bak.XXXXXXXXXX")"
  umask "${old_umask}"
  if ! cp -a "${CONFIG}" "${BACKUP}" || [[ ! -s "${BACKUP}" ]]; then
    echo "Error: Cannot copy ${CONFIG} to backup file." >&2
    exit 1
  fi
  BACKUP_READY=1

  TMP_CFG="$(mktemp "${SSH_DIR}/sshd_config.bw_keysetup.tmp.XXXXXXXXXX")"
  cp -a "${CONFIG}" "${TMP_CFG}"
  awk '
    BEGIN {
      inserted = 0
      in_match = 0
      comment_dir_re = "^[[:space:]]*#+[[:space:]]*permitrootlogin([[:space:]]+|[[:space:]]*=[[:space:]]*)(yes|no|prohibit-password|without-password|forced-commands-only)[[:space:]]*$"
      active_dir_re  = "^[[:space:]]*permitrootlogin([[:space:]=]|$)"
    }
    !in_match && tolower($0) ~ /^[[:space:]]*match([[:space:]=]|$)/ {
      if (!inserted) {
        print "PermitRootLogin prohibit-password"
        inserted = 1
      }
      in_match = 1
      print
      next
    }
    !in_match && tolower($0) ~ /^[[:space:]]*include([[:space:]=]|$)/ {
      if (!inserted) {
        print "PermitRootLogin prohibit-password"
        inserted = 1
      }
      print
      next
    }
    !in_match && tolower($0) ~ active_dir_re {
      if (!inserted) {
        print "PermitRootLogin prohibit-password"
        inserted = 1
      }
      next
    }
    !in_match && tolower($0) ~ comment_dir_re {
      if (!inserted) {
        print "PermitRootLogin prohibit-password"
        inserted = 1
        next
      }
    }
    { print }
    END {
      if (!inserted) {
        print "PermitRootLogin prohibit-password"
      }
    }
  ' "${CONFIG}" > "${TMP_CFG}"
  mv -f -- "${TMP_CFG}" "${CONFIG}"
  TMP_CFG=""
  WRITTEN=1
fi

if ! sshd -t; then
  echo "Error: sshd configuration check failed." >&2
  exit 1
fi

for ctx in "user=root,host=localhost,addr=127.0.0.1" "user=root,host=example.invalid,addr=192.0.2.1"; do
  if ! effective_cfg="$(sshd -T -C "${ctx}")"; then
    echo "Error: Cannot read effective sshd configuration for ${ctx}." >&2
    exit 1
  fi
  effective_root_login="$(printf '%s\n' "${effective_cfg}" | awk 'tolower($1) == "permitrootlogin" { print tolower($2); exit }')"
  effective_pubkey="$(printf '%s\n' "${effective_cfg}" | awk 'tolower($1) == "pubkeyauthentication" { print tolower($2); exit }')"
  if [[ "${effective_root_login}" != "prohibit-password" ]]; then
    echo "Error: Effective PermitRootLogin is '${effective_root_login}' for ${ctx}, expected prohibit-password." >&2
    exit 1
  fi
  if [[ "${effective_pubkey}" != "yes" ]]; then
    echo "Error: Effective PubkeyAuthentication is '${effective_pubkey}' for ${ctx}, expected yes." >&2
    exit 1
  fi
done

ssh_units="$(systemctl list-unit-files ssh.service --no-legend 2>/dev/null || true)"
sshd_units="$(systemctl list-unit-files sshd.service --no-legend 2>/dev/null || true)"
if grep -q '^ssh\.service' <<< "${ssh_units}"; then
  SSH_UNIT="ssh.service"
elif grep -q '^sshd\.service' <<< "${sshd_units}"; then
  SSH_UNIT="sshd.service"
else
  echo "Error: Cannot find ssh or sshd systemd unit." >&2
  exit 1
fi

RELOAD_ATTEMPTED=1
systemctl reload-or-restart "${SSH_UNIT}"

COMMITTED=1
if [[ -n "${BACKUP}" && -f "${BACKUP}" ]]; then
  rm -f -- "${BACKUP}"
  BACKUP=""
  BACKUP_READY=0
fi
EOF
}

preflightRemote

rootItemID="$(findOrCreateItem "${user}" "${host}")"
checkPassLen "${rootItemID}"
checkSaltLen "${rootItemID}"
checkPass "${rootItemID}" "root"
configSSHKey "${rootItemID}" "root" "${host}"

jumperItemID="$(findOrCreateItem "jumper" "${host}")"
checkPassLen "${jumperItemID}"
checkSaltLen "${jumperItemID}"
ensureJumperUser
checkPass "${jumperItemID}" "jumper"
configSSHKey "${jumperItemID}" "jumper" "${host}"

updateSSHDConfig "${full_ssh[@]}"
