#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || -z "$1" ]]; then
    echo "Usage: ${0##*/} <search>" >&2
    exit 1
fi

search="$1"

if ! itemJSON="$(bw list items --search="${search}")" || [[ -z "$itemJSON" ]]; then
    echo "Error: Bitwarden failed to search for ${search}." >&2
    exit 1
fi

# Match only active items whose name equals the exact search string.
# shellcheck disable=SC2016
JQ_MATCH='if type == "array" then [.[] | select(type == "object" and .name == $search and (.deletedDate == null))] else error("expected array") end'

if ! cnt="$(printf '%s' "${itemJSON}" | jq -r --arg search "${search}" "${JQ_MATCH} | length")"; then
    echo "Error: jq failed to parse search results." >&2
    exit 1
fi

if [[ ! "${cnt}" =~ ^[0-9]+$ ]]; then
    echo "Error: jq returned a non-numeric item count." >&2
    exit 1
fi

if [[ "${cnt}" -eq 0 ]]; then
    echo "Error: Search found 0 items for ${search}." >&2
    exit 2
fi

if [[ "${cnt}" -gt 1 ]]; then
    echo "Error: Search found ${cnt} items for ${search}. Expected 1." >&2
    exit 3
fi

if ! printf '%s' "${itemJSON}" | jq -er --arg search "${search}" "(${JQ_MATCH}) | .[0].id | strings | select(length > 0)"; then
    echo "Error: Matched item has no valid ID." >&2
    exit 1
fi
