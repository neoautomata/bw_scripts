#!/usr/bin/env bash
set -euo pipefail

UUID_REGEX='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

if [[ $# -ne 2 || -z "$1" || -z "$2" ]]; then
    echo "Usage: ${0##*/} <itemID> <keyPrefix>" >&2
    exit 1
fi

itemID="$1"
query="$2"

if [[ ! "${itemID}" =~ ${UUID_REGEX} ]]; then
    echo "Error: itemID must be a valid UUID." >&2
    exit 1
fi

if ! command -v bw.item.attachmentID >/dev/null 2>&1; then
    echo "Error: bw.item.attachmentID is not in PATH." >&2
    exit 1
fi

exec bw.item.attachmentID "${itemID}" --prefix "${query}" --exclude-suffix ".pub" --label "Private key"
