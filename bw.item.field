#!/usr/bin/env bash
set -euo pipefail

UUID_REGEX='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

if [[ $# -ne 2 || -z "$1" || -z "$2" ]]; then
    echo "Usage: ${0##*/} <itemID> <fieldName>" >&2
    exit 1
fi

itemID="$1"
name="$2"

if [[ ! "${itemID}" =~ ${UUID_REGEX} ]]; then
    echo "Error: itemID must be a valid UUID." >&2
    exit 1
fi

if ! command -v bw.item.get >/dev/null 2>&1; then
    echo "Error: bw.item.get is not in PATH." >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "Error: jq is not in PATH." >&2
    exit 1
fi

if ! itemJSON="$(bw.item.get "${itemID}")" || [[ -z "$itemJSON" ]]; then
    echo "Error: Bitwarden failed to read item ${itemID}." >&2
    exit 1
fi

# Check the item structure and collect fields that match the requested name.
# shellcheck disable=SC2016
JQ_FIELDS='if type != "object" then error("expected object")
elif (.fields | type) != "null" and (.fields | type) != "array" then error("expected array or null fields")
else [(.fields // [])[] | select(type == "object" and .name == $name)]
end'

if ! cnt="$(printf '%s' "${itemJSON}" | jq -r --arg name "${name}" "(${JQ_FIELDS}) | length")"; then
    echo "Error: jq failed to parse item ${itemID}." >&2
    exit 1
fi

if [[ ! "${cnt}" =~ ^[0-9]+$ ]]; then
    echo "Error: jq returned a non-numeric field count." >&2
    exit 1
fi

if [[ "${cnt}" -eq 0 ]]; then
    echo "Error: Item ${itemID} has 0 fields named ${name}." >&2
    exit 2
fi

if [[ "${cnt}" -gt 1 ]]; then
    echo "Error: Item ${itemID} has ${cnt} fields named ${name}. The script requires 1 match." >&2
    exit 3
fi

if ! printf '%s' "${itemJSON}" | jq -r --arg name "${name}" "(${JQ_FIELDS})[0] | if .value == null then \"\" else (.value | tostring) end"; then
    echo "Error: jq failed to read field ${name}." >&2
    exit 1
fi
