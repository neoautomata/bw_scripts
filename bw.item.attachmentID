#!/usr/bin/env bash
set -euo pipefail

UUID_REGEX='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
ATT_ID_REGEX='^[A-Za-z0-9][A-Za-z0-9._-]*$'
JQ_ATT_ID_REGEX='\A[A-Za-z0-9][A-Za-z0-9._-]*\z'

usage() {
    echo "Usage: ${0##*/} <itemID> (--exact <name> | --prefix <prefix> [--suffix <suffix> | --exclude-suffix <suffix>]) [--label <label>]" >&2
}

if [[ $# -lt 3 || -z "${1:-}" ]]; then
    usage
    exit 1
fi

itemID="$1"
shift

if [[ ! "${itemID}" =~ ${UUID_REGEX} ]]; then
    echo "Error: itemID must be a valid UUID." >&2
    exit 1
fi

mode=""
match_val=""
suffix_mode="none"
suffix_val=""
label="Attachment"
label_set=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --exact)
            if [[ -n "${mode}" || $# -lt 2 || -z "$2" ]]; then
                usage
                exit 1
            fi
            mode="exact"
            match_val="$2"
            shift 2
            ;;
        --prefix)
            if [[ -n "${mode}" || $# -lt 2 || -z "$2" ]]; then
                usage
                exit 1
            fi
            mode="prefix"
            match_val="$2"
            shift 2
            ;;
        --suffix)
            if [[ "${suffix_mode}" != "none" || $# -lt 2 || -z "$2" ]]; then
                usage
                exit 1
            fi
            suffix_mode="include"
            suffix_val="$2"
            shift 2
            ;;
        --exclude-suffix)
            if [[ "${suffix_mode}" != "none" || $# -lt 2 || -z "$2" ]]; then
                usage
                exit 1
            fi
            suffix_mode="exclude"
            suffix_val="$2"
            shift 2
            ;;
        --label)
            if [[ "${label_set}" -ne 0 || $# -lt 2 || -z "$2" ]]; then
                usage
                exit 1
            fi
            label="$2"
            label_set=1
            shift 2
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done

if [[ -z "${mode}" ]]; then
    usage
    exit 1
fi

if [[ "${mode}" == "exact" && "${suffix_mode}" != "none" ]]; then
    usage
    exit 1
fi

if ! command -v bw.item.get >/dev/null 2>&1; then
    echo "Error: bw.item.get is not in PATH." >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "Error: jq is not in PATH." >&2
    exit 1
fi

if ! itemJSON="$(bw.item.get "${itemID}")" || [[ -z "$itemJSON" ]]; then
    echo "Error: Bitwarden failed to read item ${itemID}." >&2
    exit 1
fi

# Check the item structure and match attachments using parameterized jq variables.
# shellcheck disable=SC2016
JQ_MATCH='if type != "object" then error("expected object")
elif (.attachments | type) != "null" and (.attachments | type) != "array" then error("expected array or null attachments")
else [(.attachments // [])[] | select(type == "object" and (.fileName? | type == "string")) | select(if $mode == "exact" then .fileName == $match else (.fileName | startswith($match)) and (if $suffix_mode == "include" then (.fileName | endswith($suffix)) elif $suffix_mode == "exclude" then (.fileName | endswith($suffix) | not) else true end) end)]
end'

if ! cnt="$(printf '%s' "${itemJSON}" | jq -r \
    --arg mode "${mode}" \
    --arg match "${match_val}" \
    --arg suffix_mode "${suffix_mode}" \
    --arg suffix "${suffix_val}" \
    "(${JQ_MATCH}) | length")"; then
    echo "Error: jq failed to parse item ${itemID}." >&2
    exit 1
fi

if [[ ! "${cnt}" =~ ^[0-9]+$ ]]; then
    echo "Error: jq returned a non-numeric attachment count." >&2
    exit 1
fi

if [[ "${cnt}" -eq 0 ]]; then
    echo "Error: ${label} matched 0 attachments." >&2
    exit 2
fi

if [[ "${cnt}" -gt 1 ]]; then
    echo "Error: ${label} matched ${cnt} attachments. The script requires 1 match." >&2
    exit 3
fi

if ! att_id="$(printf '%s' "${itemJSON}" | jq -er \
    --arg mode "${mode}" \
    --arg match "${match_val}" \
    --arg suffix_mode "${suffix_mode}" \
    --arg suffix "${suffix_val}" \
    --arg id_re "${JQ_ATT_ID_REGEX}" \
    "(${JQ_MATCH})[0].id | strings | select(test(\$id_re))")"; then
    echo "Error: The matched attachment has no valid ID." >&2
    exit 1
fi

if [[ ! "${att_id}" =~ ${ATT_ID_REGEX} ]]; then
    echo "Error: The matched attachment has no valid ID." >&2
    exit 1
fi

printf '%s\n' "${att_id}"
